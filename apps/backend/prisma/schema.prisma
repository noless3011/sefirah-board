generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum BoardType {
  personal
  shared
}

enum BoardStatus {
  active
  archived
}

enum BoardBadge {
  active_project  @map("active-project")
  review_required @map("review-required")
  archived
}

enum BoardVisibility {
  private
  shared
  public
}

enum CollaboratorRole {
  viewer
  editor
}

enum ThreadStatus {
  open
  resolved
}

enum NotificationType {
  invite
  comment
  mention
  board_update @map("board-update")
}

enum CanvasElementType {
  rectangle
  ellipse
  diamond
  triangle
  line
  arrow
  connector
  text
  sticky_note   @map("sticky-note")
  image
  frame
  service_card  @map("service-card")
  database_card @map("database-card")
}

enum TemplateCategory {
  Flowcharts
  Brainstorming
  Design_Systems     @map("Design Systems")
  Project_Management @map("Project Management")
  Agile_Frameworks   @map("Agile Frameworks")
}

enum ExportStatus {
  pending
  processing
  completed
  failed
}

enum ExportFormat {
  png
  pdf
  svg
}

// =============================================================================
// 2 & 3. AUTH & USER DOMAIN
// =============================================================================

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  fullName  String
  password  String?
  avatarUrl String?

  preferences Json @default("{\"emailNotifications\": true, \"cursorVisibility\": true}")

  refreshTokens       RefreshToken[]
  oauthAccounts       OAuthAccount[]
  passwordResetTokens PasswordResetToken[]

  ownedBoards     Board[]         @relation("BoardOwner")
  sharedBoards    Board[]         @relation("BoardSharedBy")
  collaborations  Collaborator[]
  createdElements Element[]
  threads         Thread[]
  threadReplies   ThreadReply[]
  notifications   Notification[]
  inviteLinks     InviteLink[]    @relation("InviteLinkCreator")
  redeemedInvites InviteLink[]    @relation("InviteLinkRedeemer")
  boardRevisions  BoardRevision[]
  exportJobs      ExportJob[]     @relation("ExportJobRequester")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OAuthAccount {
  id                String  @id @default(uuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// =============================================================================
// 4. BOARD MANAGEMENT DOMAIN
// =============================================================================

model Board {
  id           String          @id @default(uuid())
  title        String
  thumbnailUrl String?

  type           BoardType       @default(personal)
  status         BoardStatus     @default(active)
  badge          BoardBadge?
  visibilityIcon BoardVisibility @default(private)

  ownerId String
  owner   User   @relation("BoardOwner", fields: [ownerId], references: [id])

  sharedById String?
  sharedBy   User?   @relation("BoardSharedBy", fields: [sharedById], references: [id], onDelete: SetNull)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])

  elements      Element[]
  collaborators Collaborator[]
  revisions     BoardRevision[]
  threads       Thread[]
  inviteLinks   InviteLink[]
  notifications Notification[]
  exportJobs    ExportJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([sharedById])
  @@index([type])
  @@index([status])
  @@index([title])
}

// =============================================================================
// 5. TEMPLATES DOMAIN
// =============================================================================

model Template {
  id           String           @id @default(uuid())
  title        String
  description  String
  thumbnailUrl String?
  category     TemplateCategory
  elements     Json             @default("[]")
  boards       Board[]

  createdAt DateTime @default(now())

  @@index([category])
}

// =============================================================================
// 6. CANVAS ELEMENTS
// =============================================================================

model Element {
  id       String            @id @default(uuid())
  type     CanvasElementType

  x        Float
  y        Float
  width    Float
  height   Float
  rotation Float   @default(0)
  zIndex   Int     @default(0)
  isLocked Boolean @default(false)

  appearance Json

  content String?

  badge       String?
  title       String?
  description String?

  src     String?
  altText String?

  label           String?
  childElementIds Json?

  startElementId    String?
  startElement      Element?  @relation("ConnectorStart", fields: [startElementId], references: [id], onDelete: SetNull)
  endElementId      String?
  endElement        Element?  @relation("ConnectorEnd", fields: [endElementId], references: [id], onDelete: SetNull)
  connectorsAsStart Element[] @relation("ConnectorStart")
  connectorsAsEnd   Element[] @relation("ConnectorEnd")

  points     Json?
  strokeDash Boolean?

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  // FIX: Made createdBy nullable + onDelete: SetNull.
  // The original non-nullable FK with no onDelete defaults to Restrict, blocking
  // deletion of any user who has ever created a canvas element. Matching the
  // established pattern for Thread/ThreadReply authors: the element survives
  // user deletion and createdBy nulls out. The TS model's GetCanvasElementsResponse
  // already types createdBy as UUID (required at write time); reads that need to
  // display creator info should join cautiously or use the stored element data.
  createdBy String?
  creator   User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threads Thread[]

  @@index([boardId])
  @@index([boardId, zIndex])
}

// =============================================================================
// COLLABORATION & SHARING DOMAIN
// =============================================================================

model Collaborator {
  id      String           @id @default(uuid())
  userId  String
  boardId String
  role    CollaboratorRole @default(viewer)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([userId, boardId])
  @@index([boardId])
  @@index([userId])
}

model InviteLink {
  id      String @id @default(uuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("InviteLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  role       CollaboratorRole
  inviteCode String           @unique
  expiresAt  DateTime

  redeemedAt   DateTime?
  redeemedById String?
  redeemedBy   User?   @relation("InviteLinkRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([boardId])
}

// =============================================================================
// ASYNC BOARD EXPORT
// =============================================================================

model ExportJob {
  id    String @id @default(uuid())

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  // FIX: Made requestedById nullable + onDelete: SetNull.
  // The original schema had no onDelete, defaulting to Restrict — blocking user
  // deletion for any user who has ever triggered a board export. Export jobs are
  // operational/audit records that should outlive the requesting account.
  requestedById String?
  requestedBy   User?   @relation("ExportJobRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  format      ExportFormat
  status      ExportStatus @default(pending)
  downloadUrl String?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
  @@index([requestedById])
}

// =============================================================================
// 8. BOARD HISTORY DOMAIN
// =============================================================================

model BoardRevision {
  id      String  @id @default(uuid())
  boardId String
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  authorId     String?
  author       User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName   String
  elementCount Int    @default(0)
  description  String
  elements     Json   @default("[]")

  createdAt DateTime @default(now())

  @@index([boardId])
  @@index([boardId, createdAt(sort: Desc)])
}

// =============================================================================
// 9. THREADS / CHAT DOMAIN
// =============================================================================

model Thread {
  id      String @id @default(uuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  targetElementId String?
  targetElement   Element? @relation(fields: [targetElementId], references: [id], onDelete: SetNull)

  authorId        String?
  author          User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName      String
  authorAvatarUrl String?
  message         String
  status          ThreadStatus @default(open)
  replies         ThreadReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
  @@index([targetElementId])
}

model ThreadReply {
  id       String @id @default(uuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId        String?
  author          User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName      String
  authorAvatarUrl String?
  message         String

  createdAt DateTime @default(now())

  @@index([threadId])
}

// =============================================================================
// 10. NOTIFICATIONS DOMAIN
// =============================================================================

model Notification {
  id      String           @id @default(uuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  message String
  boardId String?
  board   Board?           @relation(fields: [boardId], references: [id], onDelete: SetNull)
  isRead  Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}
